{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROJECTUS",
  "version": "0.1.0",
  "identifier": "com.projectus.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @projectus/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @projectus/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PROJECTUS",
        "width": 1480,
        "height": 920,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4387; img-src 'self' asset: http://127.0.0.1:4387 data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Kanban local para projetos e tarefas"
  }
}
