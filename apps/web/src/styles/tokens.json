{
  "$schema": "./tokens.schema.json",
  "_doc": "Single source of truth for PROJECTUS design tokens. Consumed by Rust (include_str! + serde) for default palette, and by TS/CSS (Vite JSON import) for motion/system tokens. Never duplicate a value — change here, sync tokens.css. New scales: peso (font-weights), z (z-index layers), sombra (shadows), rastreamento (letter-spacing), tipografia.escala title tiers — all mirrored in tokens.css.",
  "palette": [
    { "id": "vermelho", "titulo": "Vermelho", "valor": "#FF4848" },
    { "id": "laranja", "titulo": "Laranja", "valor": "#FF6F2C" },
    { "id": "amarelo", "titulo": "Amarelo", "valor": "#FAD344" },
    { "id": "verde", "titulo": "Verde", "valor": "#61E141" },
    { "id": "agua-verde", "titulo": "Água-verde", "valor": "#45E0B9" },
    { "id": "azul", "titulo": "Azul", "valor": "#55B9F7" },
    { "id": "roxo", "titulo": "Roxo", "valor": "#9C66FF" },
    { "id": "rosa", "titulo": "Rosa", "valor": "#FE3867" },
    { "id": "salvia", "titulo": "Salvia", "valor": "#6A9071" },
    { "id": "cobre", "titulo": "Cobre", "valor": "#9F5F35" },
    { "id": "areia", "titulo": "Areia", "valor": "#B0955B" },
    { "id": "cinza", "titulo": "Cinza", "valor": "#BCC2C9" }
  ],
  "acento_default": "#55B9F7",
  "coluna_neutra_default": "#BCC2C9",
  "sistema": {
