    "tinta_2": "#2A2A2A",
    "tinta_3": "#3A3A3A",
    "linha": "#3A3A3A",
    "papel": "#F5F2EA",
    "texto_2": "#B8B3A4",
    "texto_3": "#6E6A60"
  },
  "semantico": {
    "ok": "#61E141",
    "erro": "#FF4848",
    "alerta": "#FAD344"
  },
  "espacamento": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "raios": {
    "nenhum": "0px"
  },
  "tipografia": {
    "fontes": {
      "mono": "'JetBrains Mono', ui-monospace, monospace",
      "display": "'Space Grotesk', system-ui, sans-serif"
    },
    "escala": {
      "xs": { "tamanho": "10px", "altura": "1.4", "rastro": "0.22em" },
      "sm": { "tamanho": "11px", "altura": "1.5", "rastro": "0.08em" },
      "base": { "tamanho": "12px", "altura": "1.5", "rastro": "0" },
      "md": { "tamanho": "13px", "altura": "1.55", "rastro": "0" },
      "lg": { "tamanho": "14px", "altura": "1.55", "rastro": "0" },
      "xl": { "tamanho": "22px", "altura": "1.2", "rastro": "-0.02em" },
      "titulo_sm": { "tamanho": "16px", "altura": "1.25", "rastro": "0" },
      "titulo": { "tamanho": "17px", "altura": "1.25", "rastro": "0" },
      "titulo_lg": { "tamanho": "18px", "altura": "1", "rastro": "0" },
      "grande_2x": { "tamanho": "32px", "altura": "1", "rastro": "-0.04em" },
      "cartaz": { "tamanho": "44px", "altura": "1", "rastro": "-0.04em" },
      "display": { "tamanho": "clamp(32px, 4vw, 46px)", "altura": "0.96", "rastro": "-0.045em" }
    }
  },
  "movimento": {
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
