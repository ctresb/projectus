    "duracao_padrao_ms": 200,
    "duracao_lenta_ms": 320,
    "duracao_rapida_s": 0.12,
    "duracao_padrao_s": 0.16,
    "duracao_lenta_s": 0.32
  },
  "componentes": {
    "controle": {
      "altura_grande": "40px",
      "altura_media": "36px",
      "altura_pequena": "30px",
      "altura_mini": "26px"
