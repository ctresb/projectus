  "z": {
    "base": 1,
    "card": 2,
    "raised": 3,
    "sticky": 5,
    "rail": 10,
    "backdrop": 20,
    "overlay": 40,
    "popover": 60,
    "dropdown": 80
  },
  "sombra": {
    "popover": "0 12px 30px rgba(0,0,0,0.42)",
    "pop": "0 8px 24px rgba(0,0,0,0.4)"
  },
  "rastreamento": {
    "largo": "0.02em"
  }
}
